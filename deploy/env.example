# Copy to /var/www/impact-festival/.env on the server (never commit real values).
REG_ADMIN_TOKEN=change-me-to-a-long-random-string
PORT=3002

# Gmail / Google Workspace SMTP (App Password required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@theimpactfestival.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=Impact Festival Team <info@theimpactfestival.com>
MAIL_REPLY_TO=info@theimpactfestival.com
MAIL_NOTIFY=info@theimpactfestival.com
